# Serveur
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-key-min-32-chars

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Brevo (Email)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=ARTISANTS

# Business workspace invitations
BUSINESS_INVITE_REDIRECT_URL=artisant://business-invite

# Optional: only for Yousign contracts already in progress; new contracts are signed in-app.
YOUSIGN_ENV=sandbox
YOUSIGN_API_KEY=your-yousign-api-key
YOUSIGN_WEBHOOK_SECRET=your-yousign-webhook-secret

# CORS - domaines autorisés (séparés par des virgules)
CORS_ORIGINS=https://your-mobile-app.com,https://your-admin-panel.com
