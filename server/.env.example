# Serveur
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-key-min-32-chars

# Google Play subscriptions
# Create active monthly subscription products with these IDs, and place them in the same subscription group:
# artisants_pro_monthly, artisants_premium_monthly, artisants_enterprise_monthly.
# Enable the Google Play Android Developer API and grant the service account access to this app.
GOOGLE_PLAY_PACKAGE_NAME=com.artisants.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"client_email":"service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Configure Pub/Sub RTDN with an authenticated push endpoint and this exact audience/service-account email.
GOOGLE_PLAY_RTDN_AUDIENCE=https://your-api.example.com/api/v1/subscriptions/google-play/notifications
GOOGLE_PLAY_RTDN_EMAIL=pubsub-push-service-account@project.iam.gserviceaccount.com

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Brevo (Email)
BREVO_API_KEY=your-brevo-api-key

# CORS - domaines autorisés (séparés par des virgules)
CORS_ORIGINS=https://your-mobile-app.com,https://your-admin-panel.com
