# Copy this file to .env.local and replace every placeholder with values from
# the same Supabase project. Never commit .env.local.
NODE_ENV=development
PORT=3000

# Backend: private credentials. Keep the service-role key server-side only.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_private_service_role_key
SUPABASE_WEBHOOK_SECRET=replace_with_a_random_secret

# Optional integrations
EXPO_ACCESS_TOKEN=
BREVO_API_KEY=

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Admin dashboard: the anon/publishable key is public; never put service-role
# credentials in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_public_anon_or_publishable_key
VITE_API_URL=http://localhost:3000/api/v1
