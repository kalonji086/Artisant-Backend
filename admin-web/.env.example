# Ces variables Vite sont centralisées dans le fichier .env.local à la racine.
# Consulter ../.env.local.example; ne pas copier ce fichier en admin-web/.env.
# Clés publiques Supabase (anon JWT ou publishable key, dans Settings → API)
# La clé doit appartenir au même projet que VITE_SUPABASE_URL.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=cle_anon_publique

# URL de l'API ARTISANTS (server/ Express)
VITE_API_URL=http://localhost:3000/api/v1
